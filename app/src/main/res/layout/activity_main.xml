<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_broadcast_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">

    <!-- Camera Preview (Live Match Feed) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview_broadcast"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- AI Status Message -->
    <TextView
        android:id="@+id/text_ai_status_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Status: All tracking OFF"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:background="#88000000"
        android:padding="4dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- AI Tracking Toggle Buttons -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle_ai_tracking_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/text_ai_status_message"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_toggle_ball_tracking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ball"
            android:textSize="10sp"
            android:padding="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/btn_toggle_player_tracking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Players"
            android:textSize="10sp"
            android:padding="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/btn_toggle_pose_estimation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pose"
            android:textSize="10sp"
            android:padding="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/button_start_recording_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Record"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@id/button_quick_wicket_main"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/button_quick_wicket_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wicket!"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@id/scoreboard_overlay_container"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_main_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_more"
        app:layout_constraintBottom_toTopOf="@id/scoreboard_overlay_container"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Hidden Legacy Elements (not visible but referenced in code) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/edit_text_player_name"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_player_scores"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_start_recording"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_stop_recording"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Scoreboard Overlay -->
    <FrameLayout
        android:id="@+id/scoreboard_overlay_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="#CC000000"
        android:padding="8dp">

        <!-- Include the existing cricket_score_panel or a new simplified one -->
        <include
            android:id="@+id/cricket_score_panel_broadcast"
            layout="@layout/cricket_score_panel_simplified"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </FrameLayout>

    <!-- Minimal Controls / Channel Logo (Optional) -->
    <ImageView
        android:id="@+id/channel_logo_overlay"
        android:layout_width="70dp"
        android:layout_height="35dp"
        android:src="@drawable/logo"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:alpha="0.8"
        android:contentDescription="SPU Logo" />

</androidx.constraintlayout.widget.ConstraintLayout>
