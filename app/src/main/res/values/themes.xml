<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SPUCRICKETCLUB" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/spu_blue</item>
        <item name="colorPrimaryVariant">@color/spu_dark_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/spu_gold</item>
        <item name="colorSecondaryVariant">@color/spu_gold_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize other theme attributes. -->
    </style>

    <style name="Theme.SPUCRICKETCLUB" parent="Base.Theme.SPUCRICKETCLUB" />

    <!-- Style for section titles -->
    <style name="SectionTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/spu_blue</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <!-- Style for subsection titles -->
    <style name="SubsectionTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/spu_gold_dark</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <!-- Style for cards -->
    <style name="CricketCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/spu_blue</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Style for buttons -->
    <style name="CricketButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="backgroundTint">@color/spu_blue</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Style for outlined buttons -->
    <style name="CricketButtonOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="strokeColor">@color/spu_blue</item>
        <item name="android:textColor">@color/spu_blue</item>
    </style>

    <!-- Style for text buttons -->
    <style name="CricketButtonText" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/spu_blue</item>
    </style>

    <!-- Scoreboard text style -->
    <style name="ScoreboardText">
        <item name="android:textColor">@color/scoreboard_text</item>
        <item name="android:background">@color/scoreboard_background</item>
        <item name="android:padding">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>